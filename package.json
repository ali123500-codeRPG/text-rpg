{
  "name": "text-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "perks-doc": "esbuild scripts/perks-doc.ts --bundle --platform=node --format=esm --outfile=dist/perks-doc.mjs --log-level=warning && node dist/perks-doc.mjs",
    "playtest": "esbuild scripts/playtest.ts --bundle --platform=node --format=esm --outfile=dist/playtest.mjs --log-level=warning && node dist/playtest.mjs",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "icons": "node scripts/icons.mjs",
    "figures": "node scripts/figures.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iconify-json/fluent-emoji-high-contrast": "^1.2.6",
    "@iconify-json/game-icons": "^1.2.4",
    "@types/three": "^0.170.0",
    "esbuild": "^0.25.0",
    "meshoptimizer": "^0.22.0",
    "playwright": "1.63.0",
    "three": "^0.170.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
