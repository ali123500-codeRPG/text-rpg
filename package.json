{
  "name": "text-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "perks-doc": "esbuild scripts/perks-doc.ts --bundle --platform=node --format=esm --outfile=dist/perks-doc.mjs --log-level=warning && node dist/perks-doc.mjs",
    "playtest": "esbuild scripts/playtest.ts --bundle --platform=node --format=esm --outfile=dist/playtest.mjs --log-level=warning && node dist/playtest.mjs",
    "smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
